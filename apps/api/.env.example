# AWS Bedrock (optional). Without these, the agent falls back to the deterministic
# rule-based supervisor. Never commit real credentials — apps/api/.env is gitignored.
AWS_REGION=us-east-1
# Provide credentials one of these ways: static keys, a named profile, or an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Set to 1 to force the rule-based fallback even when AWS creds are present.
# DISABLE_BEDROCK=1
